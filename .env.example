# Optional: OpenAI API key for richer LLM summaries.
# Without this, the agent uses extractive summaries from abstracts.
OPENAI_API_KEY=

# Model used when OPENAI_API_KEY is set
OPENAI_MODEL=gpt-4o-mini

# How many papers to keep each weekly run (after ranking)
PAPERS_PER_RUN=20

# arXiv categories to search (comma-separated)
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV

# Seed interest keywords (comma or newline separated).
# You can also edit them in the UI or in data/interests.txt
INTEREST_KEYWORDS=LLM agents, retrieval augmented generation, diffusion models

# Path to a plain-text interests file (one keyword/phrase per line)
INTERESTS_FILE=./data/interests.txt

# Optional Semantic Scholar API key for higher citation lookup rate limits
SEMANTICSCHOLAR_API_KEY=

# If true, drop papers that match none of your interest keywords
REQUIRE_KEYWORD_MATCH=false

# Weekly schedule (cron-style day of week: mon=0 ... sun=6)
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Database path
DATABASE_URL=sqlite:///./data/papers.db
