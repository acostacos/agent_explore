# Optional: OpenAI API key for richer LLM summaries.
# Without this, the agent uses extractive summaries from abstracts.
OPENAI_API_KEY=

# Model used when OPENAI_API_KEY is set
OPENAI_MODEL=gpt-4o-mini

# How many papers to fetch each weekly run
PAPERS_PER_RUN=20

# arXiv categories to search (comma-separated)
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV

# Weekly schedule (cron-style day of week: mon=0 ... sun=6)
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Database path
DATABASE_URL=sqlite:///./data/papers.db
